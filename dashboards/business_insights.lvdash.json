{
  "datasets": [
    {
      "name": "wx_daily",
      "displayName": "Weather daily (gold)",
      "queryLines": [
        "SELECT location_name, weather_date_utc, min_temperature_c, avg_temperature_c, max_temperature_c,\n       total_precipitation_mm, precipitation_hours, max_wind_speed_kmh, avg_relative_humidity_pct,\n       CAST(heat_alert AS INT) AS heat_alert_day, CAST(high_wind_alert AS INT) AS wind_alert_day,\n       CAST(heavy_precipitation_alert AS INT) AS heavy_precip_alert_day, is_complete_day\nFROM workspace.met_gold.weather_daily\n"
      ]
    },
    {
      "name": "wx_hourly",
      "displayName": "Weather hourly (silver)",
      "queryLines": [
        "SELECT location_name, timestamp_utc, temperature_c, relative_humidity_pct, precipitation_mm, wind_speed_kmh\nFROM workspace.met_silver.weather_hourly\n"
      ]
    },
    {
      "name": "wx_compare",
      "displayName": "City comparison",
      "queryLines": [
        "SELECT location_name,\n       MIN(min_temperature_c)                  AS window_min_temp_c,\n       MAX(max_temperature_c)                  AS window_max_temp_c,\n       ROUND(AVG(avg_temperature_c), 1)        AS window_avg_temp_c,\n       ROUND(SUM(total_precipitation_mm), 1)   AS window_precip_mm,\n       COUNT_IF(total_precipitation_mm >= 1.0) AS wet_days,\n       MAX(max_wind_speed_kmh)                 AS window_max_wind_kmh,\n       COUNT_IF(heat_alert OR high_wind_alert OR heavy_precipitation_alert) AS alert_days\nFROM workspace.met_gold.weather_daily GROUP BY location_name\n"
      ]
    },
    {
      "name": "wx_alerts",
      "displayName": "Alert days",
      "queryLines": [
        "SELECT weather_date_utc, location_name, max_temperature_c, max_wind_speed_kmh, total_precipitation_mm,\n       concat_ws(', ', IF(heat_alert, 'heat', NULL), IF(high_wind_alert, 'high wind', NULL),\n                 IF(heavy_precipitation_alert, 'heavy precipitation', NULL)) AS alerts\nFROM workspace.met_gold.weather_daily\nWHERE heat_alert OR high_wind_alert OR heavy_precipitation_alert\n"
      ]
    },
    {
      "name": "wx_updated",
      "displayName": "Last updated (gold)",
      "queryLines": [
        "SELECT concat(date_format(MAX(updated_at), 'yyyy-MM-dd HH:mm'), ' UTC') AS last_updated\nFROM workspace.met_gold.weather_daily\n"
      ]
    },
    {
      "name": "eq_daily",
      "displayName": "Earthquakes daily (gold)",
      "queryLines": [
        "SELECT region_name, event_date_utc, quake_count, max_magnitude, avg_magnitude, significant_quakes, strongest_place\nFROM workspace.met_gold.earthquakes_daily\n"
      ]
    },
    {
      "name": "eq_region",
      "displayName": "Earthquakes by region",
      "queryLines": [
        "SELECT region_name, SUM(quake_count) AS quakes, MAX(max_magnitude) AS max_magnitude,\n       SUM(significant_quakes) AS significant_quakes\nFROM workspace.met_gold.earthquakes_daily GROUP BY region_name\n"
      ]
    },
    {
      "name": "eq_top",
      "displayName": "Strongest events",
      "queryLines": [
        "SELECT event_time_utc, region_name, magnitude, place, depth_km\nFROM workspace.met_silver.earthquake_events ORDER BY magnitude DESC LIMIT 15\n"
      ]
    },
    {
      "name": "eq_updated",
      "displayName": "Last updated (gold)",
      "queryLines": [
        "SELECT concat(date_format(MAX(updated_at), 'yyyy-MM-dd HH:mm'), ' UTC') AS last_updated\nFROM workspace.met_gold.earthquakes_daily\n"
      ]
    }
  ],
